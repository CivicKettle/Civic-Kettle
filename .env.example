# Copy to .env.local for local dev. On Netlify these go under Environment variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of the deployed site, used in sign-in emails
NEXT_PUBLIC_SITE_URL=https://civickettle.com
# Server-only. Public sign-up, reminders and the website form use this.
SUPABASE_SECRET_KEY=
# Email (Resend). EMAIL_FROM switches to hello@civickettle.com after the domain is verified.
RESEND_API_KEY=
EMAIL_FROM=CivicKettle <onboarding@resend.dev>
# Protects the scheduled reminder endpoints. Vercel sends it automatically when set.
CRON_SECRET=
